# Optional OpenAI mode. The application runs deterministically without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Keep false for an offline-safe demo. If true, a local YOLO weight is used
# when YOLO_MODEL_PATH points to a file inside the project.
ENABLE_YOLO=false
YOLO_MODEL_PATH=assets/models/yolov8n.pt

API_HOST=0.0.0.0
API_PORT=8000
STREAM_INTERVAL_SECONDS=5

# Use public live providers (Open-Meteo + Google News RSS) instead of the
# deterministic demo streams. Falls back automatically if a provider is down.
LIVE_DATA_ENABLED=true
LIVE_DATA_TIMEOUT_SECONDS=8
SOCIAL_FEED_QUERY=Mumbai flood OR waterlogging OR heavy rain

# Optional local CCTV clip. The API advances one frame per live cycle.
# You can also upload a clip from the Streamlit dashboard.
CCTV_VIDEO_PATH=
