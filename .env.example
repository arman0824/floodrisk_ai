# Optional OpenAI mode. The application runs deterministically without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Keep false for an offline-safe demo. If true, a local YOLO weight is used
# when YOLO_MODEL_PATH points to a file inside the project.
ENABLE_YOLO=false
YOLO_MODEL_PATH=assets/models/yolov8n.pt

API_HOST=0.0.0.0
API_PORT=8000
STREAM_INTERVAL_SECONDS=5
