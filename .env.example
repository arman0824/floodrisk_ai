# Optional OpenAI mode. The application runs deterministically without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

API_HOST=0.0.0.0
API_PORT=8000
STREAM_INTERVAL_SECONDS=5

# Use public live providers (Open-Meteo + Google News RSS) instead of the
# deterministic demo streams. Falls back automatically if a provider is down.
LIVE_DATA_ENABLED=true
LIVE_DATA_TIMEOUT_SECONDS=8
SOCIAL_FEED_QUERY=Mumbai flood OR waterlogging OR heavy rain
